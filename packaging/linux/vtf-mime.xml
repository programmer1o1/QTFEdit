<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="image/x-vtf">
    <comment>Valve Texture Format</comment>
    <comment xml:lang="en">Valve Texture Format image</comment>
    <glob pattern="*.vtf"/>
    <magic priority="80">
      <match value="VTF\0" type="string" offset="0"/>
    </magic>
    <icon name="image-x-generic"/>
  </mime-type>
  <mime-type type="text/x-vmt">
    <comment>Valve Material Type</comment>
    <comment xml:lang="en">Valve Material Type material definition</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.vmt"/>
  </mime-type>
</mime-info>
